@@ -0,0 +1,52 @@
+import express from "express";
+import cors from "cors";
+import helmet from "helmet";
+import compression from "compression";
+import { taskRouter } from "./routes/tasks";
+import { boardRouter } from "./routes/boards";
+import { healthRouter } from "./routes/health";
+import { errorHandler } from "./middleware/errorHandler";
+import { requestLogger } from "./middleware/requestLogger";
+import { connectDatabase } from "./database/connection";
+
+async function bootstrap() {
+  await connectDatabase();
+
+  const app = express();
+  const port = parseInt(process.env.PORT || "3000", 10);
+
+  app.use(helmet());
+  app.use(cors({ origin: process.env.CORS_ORIGIN || "*" }));
+  app.use(compression());
+  app.use(express.json({ limit: "10mb" }));
+  app.use(requestLogger);
+
+  app.use("/health", healthRouter);
+  app.use("/api/tasks", taskRouter);
+  app.use("/api/boards", boardRouter);
+
+  app.use(errorHandler);
+
+  app.listen(port, () => {
+    console.log(`TaskBoard API running on port ${port}`);
+  });
+}
+
+bootstrap().catch(err => {
+  console.error("Failed to start:", err);
+  process.exit(1);
+});
diff --git a/src/routes/tasks.ts b/src/routes/tasks.ts
new file mode 100644
index 0000000..ddd4444
--- /dev/null
+++ b/src/routes/tasks.ts
@@ -0,0 +1,58 @@
+import { Router, Request, Response } from "express";
+import { db } from "../database/connection";
+
+const taskRouter = Router();
+
+taskRouter.get("/", async (req: Request, res: Response) => {
+  const boardId = req.query.boardId as string;
+  let query = "SELECT * FROM tasks";
+  let params: string[] = [];
+
+  if (boardId) {
+    query += " WHERE board_id = $1";
+    params.push(boardId);
+  }
+
+  query += " ORDER BY position ASC";
+  const tasks = await db.query(query, params);
+  res.json(tasks);
+});
+
+taskRouter.get("/:id", async (req: Request, res: Response) => {
+  const task = await db.query("SELECT * FROM tasks WHERE id = $1", [req.params.id]);
+  if (!task.length) return res.status(404).json({ error: "Task not found" });
+  res.json(task[0]);
+});
+
+taskRouter.post("/", async (req: Request, res: Response) => {
+  const { title, description, boardId, assigneeId, priority } = req.body;
+  if (!title || !boardId) return res.status(400).json({ error: "title and boardId required" });
+
+  const maxPos = await db.query("SELECT COALESCE(MAX(position), 0) + 1 as pos FROM tasks WHERE board_id = $1", [boardId]);
+  const result = await db.query(
+    "INSERT INTO tasks (title, description, board_id, assignee_id, priority, position) VALUES ($1, $2, $3, $4, $5, $6) RETURNING *",
+    [title, description || "", boardId, assigneeId || null, priority || "medium", maxPos[0].pos]
+  );
+  res.status(201).json(result[0]);
+});
+
+taskRouter.patch("/:id", async (req: Request, res: Response) => {
+  const updates = req.body;
+  const fields = Object.keys(updates);
+  if (!fields.length) return res.status(400).json({ error: "No fields to update" });
+
+  const setClauses = fields.map((f, i) => `${f} = $${i + 2}`);
+  const values = [req.params.id, ...fields.map(f => updates[f])];
+  const result = await db.query(
+    `UPDATE tasks SET ${setClauses.join(", ")}, updated_at = NOW() WHERE id = $1 RETURNING *`,
+    values
+  );
+  if (!result.length) return res.status(404).json({ error: "Task not found" });
+  res.json(result[0]);
+});
+
+taskRouter.delete("/:id", async (req: Request, res: Response) => {
+  const result = await db.query("DELETE FROM tasks WHERE id = $1 RETURNING id", [req.params.id]);
+  if (!result.length) return res.status(404).json({ error: "Task not found" });
+  res.json({ deleted: true });
+});
+
+export { taskRouter };

+/**
+ * Helper utilities for data transformation.
+ * Important: All functions validate input before processing.
+ */
+
+// Note: Pure functions only — no side effects
+export const formatDate = (date: Date): string => {
+  try {
+    if (!date) return "";
+    return date.toISOString().split("T")[0] ?? "";
+  } catch {
+    return "Invalid date";
+  }
+};
+
+export const slugify = (text: string): string => {
+  try {
+    if (!text) return "";
+    return text
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, "-")
+      .replace(/(^-|-$)/g, "");
+  } catch {
+    return "";
+  }
+};
+
+// Important: Sanitize all user-provided strings
+export const sanitize = (input: string): string => {
+  if (!input) return "";
+  return input.replace(/[<>&"']/g, "");
+};

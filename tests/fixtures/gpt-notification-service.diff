+import { EventEmitter } from "events";
+
+interface NotificationConfig {
+  maxRetries: number;
+  retryDelay: number;
+  batchSize: number;
+}
+
+interface Notification {
+  id: string;
+  userId: string;
+  type: string;
+  title: string;
+  body: string;
+  read: boolean;
+  createdAt: Date;
+}
+
+class NotificationService extends EventEmitter {
+  private config: NotificationConfig;
+  private queue: Notification[] = [];
+  private processing = false;
+
+  constructor(config: Partial<NotificationConfig> = {}) {
+    super();
+    this.config = {
+      maxRetries: config.maxRetries || 3,
+      retryDelay: config.retryDelay || 1000,
+      batchSize: config.batchSize || 10,
+    };
+  }
+
+  async send(notification: Omit<Notification, "id" | "read" | "createdAt">) {
+    const fullNotification: Notification = {
+      ...notification,
+      id: this.generateId(),
+      read: false,
+      createdAt: new Date(),
+    };
+
+    this.queue.push(fullNotification);
+    this.emit("queued", fullNotification);
+
+    if (!this.processing) {
+      await this.processQueue();
+    }
+
+    return fullNotification;
+  }
+
+  private async processQueue() {
+    this.processing = true;
+
+    while (this.queue.length > 0) {
+      let batch = this.queue.splice(0, this.config.batchSize);
+
+      for (let i = 0; i < batch.length; i++) {
+        let notification = batch[i];
+        let retries = 0;
+
+        while (retries < this.config.maxRetries) {
+          try {
+            await this.deliver(notification);
+            this.emit("delivered", notification);
+            break;
+          } catch (error) {
+            retries++;
+            if (retries >= this.config.maxRetries) {
+              this.emit("failed", { notification, error });
+            } else {
+              await this.delay(this.config.retryDelay * retries);
+            }
+          }
+        }
+      }
+    }
+
+    this.processing = false;
+  }
+
+  private async deliver(notification: Notification) {
+    // Simulated delivery — replace with actual push/email/SMS provider
+    console.log(`Delivering notification ${notification.id} to ${notification.userId}`);
+  }
+
+  private delay(ms: number) {
+    return new Promise(resolve => setTimeout(resolve, ms));
+  }
+
+  private generateId() {
+    return Math.random().toString(36).substring(2, 15);
+  }
+}
+
+export default NotificationService;

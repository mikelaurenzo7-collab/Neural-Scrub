@@ -0,0 +1,98 @@
+/**
+ * User management API routes.
+ * Important: All endpoints require authentication except POST /users (registration).
+ */
+
+import { Router } from "express";
+import type { Request, Response } from "express";
+import type { CreateUserRequest, UpdateUserRequest, User, PaginatedResponse } from "../types/api.js";
+import { validateEmail, sanitizeInput } from "../utils/validation.js";
+import { hashPassword } from "../utils/crypto.js";
+import { db } from "../database/connection.js";
+
+const router = Router();
+
+/**
+ * Get all users with pagination.
+ * Note: Results are sorted by createdAt descending.
+ */
+router.get("/", async (req: Request, res: Response): Promise<void> => {
+  try {
+    const page = parseInt(req.query.page as string) || 1;
+    const pageSize = Math.min(parseInt(req.query.pageSize as string) || 20, 100);
+    const offset = (page - 1) * pageSize;
+
+    const [users, total] = await Promise.all([
+      db.query<User>("SELECT * FROM users ORDER BY created_at DESC LIMIT $1 OFFSET $2", [pageSize, offset]),
+      db.count("users"),
+    ]);
+
+    const response: PaginatedResponse<User> = {
+      data: users,
+      total,
+      page,
+      pageSize,
+      hasNextPage: offset + pageSize < total,
+    };
+
+    res.json(response);
+  } catch (error) {
+    console.error("Failed to fetch users:", error);
+    res.status(500).json({ code: "INTERNAL_ERROR", message: "Failed to fetch users" });
+  }
+});
+
+/**
+ * Get a single user by ID.
+ */
+router.get("/:id", async (req: Request, res: Response): Promise<void> => {
+  try {
+    const id = sanitizeInput(req.params.id);
+    if (!id) {
+      res.status(400).json({ code: "INVALID_ID", message: "User ID is required" });
+      return;
+    }
+
+    const user = await db.findOne<User>("users", { id });
+    if (!user) {
+      res.status(404).json({ code: "NOT_FOUND", message: "User not found" });
+      return;
+    }
+
+    res.json(user);
+  } catch (error) {
+    console.error("Failed to fetch user:", error);
+    res.status(500).json({ code: "INTERNAL_ERROR", message: "Failed to fetch user" });
+  }
+});
+
+/**
+ * Create a new user (registration).
+ * Important: Password is hashed before storage.
+ */
+router.post("/", async (req: Request, res: Response): Promise<void> => {
+  try {
+    const body = req.body as CreateUserRequest;
+
+    if (!body.email || !body.password || !body.displayName) {
+      res.status(400).json({ code: "MISSING_FIELDS", message: "Email, password, and displayName are required" });
+      return;
+    }
+
+    if (!validateEmail(body.email)) {
+      res.status(400).json({ code: "INVALID_EMAIL", message: "Invalid email format" });
+      return;
+    }
+
+    const existing = await db.findOne<User>("users", { email: body.email });
+    if (existing) {
+      res.status(409).json({ code: "DUPLICATE_EMAIL", message: "Email already registered" });
+      return;
+    }
+
+    const hashedPassword = await hashPassword(body.password);
+    const user = await db.insert<User>("users", {
+      email: sanitizeInput(body.email),
+      displayName: sanitizeInput(body.displayName),
+      role: body.role ?? "member",
+      password: hashedPassword,
+    });
+
+    res.status(201).json(user);
+  } catch (error) {
+    console.error("Failed to create user:", error);
+    res.status(500).json({ code: "INTERNAL_ERROR", message: "Failed to create user" });
+  }
+});
+
+export { router as usersRouter };
